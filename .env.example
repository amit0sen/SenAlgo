# ============================================================
# SenAlgo — AI Trading Agent by Amit Kumar Sen
# ============================================================
# Run `senalgo init` for interactive guided setup.
# No API key is required for market data — it's ALL FREE.
# Default LLM is Ollama (local, no key needed).
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# Choose ONE provider. Default = ollama (local, no key needed)
#
# Options:
#   ollama      — local, FREE (install from ollama.com)
#   deepseek    — ultra-cheap, GPT-4 class (api.deepseek.com)
#   groq        — fast, free tier (console.groq.com)
#   openrouter  — 200+ models (openrouter.ai)
#   gemini      — Google (ai.google.dev)
#   openai      — GPT-4o (platform.openai.com)
#   anthropic   — Claude (console.anthropic.com)
#   dashscope   — Alibaba Qwen
#   zhipu       — GLM-4
#   moonshot    — Kimi
#
SENALGO_LLM_PROVIDER=ollama
SENALGO_MODEL=                  # auto-selected per provider when blank
SENALGO_TEMPERATURE=0.0

# ── API Keys (only set the one matching your PROVIDER) ──────
# Ollama needs NO key.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=AIza...
# DASHSCOPE_API_KEY=sk-...
# ZHIPU_API_KEY=...
# MOONSHOT_API_KEY=sk-...

# ── Market Data (ALL FREE — no keys required) ────────────────
# yfinance   : US / HK / NSE / BSE equities     — no key
# ccxt (OKX) : Crypto public API                — no key
# AKShare    : A-share Chinese equities          — no key
SENALGO_DATA_CACHE=false

# ── Fyers REAL-TIME data feed (live NSE/BSE ticks) ──────────
# Required only for live intraday trading.
# Get credentials at myaccount.fyers.in/apiV2
# Leave blank to use yfinance (delayed, free)
FYERS_CLIENT_ID=
FYERS_ACCESS_TOKEN=

# ── Zerodha Kite broker ──────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ── Dhan broker ──────────────────────────────────────────────
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ── Shoonya / Finvasia broker ────────────────────────────────
SHOONYA_USER=
SHOONYA_PASSWORD=
SHOONYA_TOTP=
SHOONYA_VENDOR_CODE=
SHOONYA_API_SECRET=

# ── Alpaca broker ────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── IBKR (Interactive Brokers) ──────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497           # 7497 = paper, 7496 = live

# ── Tiger Brokers ────────────────────────────────────────────
TIGER_ID=
TIGER_PRIVATE_KEY=
TIGER_ACCOUNT=

# ── Crypto: Binance ──────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Crypto: OKX ──────────────────────────────────────────────
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ── Safety (paper mode ON by default — change carefully) ─────
SENALGO_PAPER_ONLY=true
SENALGO_MAX_ORDER_VALUE=50000
SENALGO_DAILY_LOSS_CAP=5000

# ── Server ────────────────────────────────────────────────────
SENALGO_HOST=0.0.0.0
SENALGO_PORT=8000
